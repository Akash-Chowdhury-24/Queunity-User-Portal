# AWS S3
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_BUCKET=
AWS_REGION=us-east-1

# Docker Deployment
# Docker image name (repository path without tag).
# Example: myorg/myapp
DOCKER_IMAGE_NAME=akashwpd/queunity-user-portal

# OPTIONAL — leave unset for a unique tag per build (git SHA → CI run id → timestamp); explicit tags are reused as-is
# Optional. Leave unset for a unique tag per build (git SHA, CI run id, or timestamp).
# If set explicitly, the same tag is reused — Kubernetes may keep stale pods unless imagePullPolicy is Always or a rollout restart runs.
# Example: latest
DOCKER_IMAGE_TAG=

# OPTIONAL — only required for private or non-Docker-Hub registries
# Container registry URL. Leave empty for Docker Hub.
# Examples: https://index.docker.io/v1/ | https://ghcr.io
DOCKER_REGISTRY_URL=

# OPTIONAL — only required when pushing to a private registry
# Registry username for pushing private images.
DOCKER_REGISTRY_USERNAME=

# OPTIONAL — only required when pushing to a private registry
# Registry password or personal access token.
# Docker Hub: access token. GHCR: GitHub PAT with write:packages.
DOCKER_REGISTRY_TOKEN=

# Public IP address or domain name of the server you are deploying to.
# Example: 203.0.113.10
SSH_HOST=43.204.32.46

# OS username for SSH login. Depends on the image you used:
#   Ubuntu → ubuntu | Amazon Linux → ec2-user | Debian → admin
# Check your provider instance details if unsure.
# Example: ubuntu
SSH_USER=ec2-user

# Path to your PRIVATE SSH key file (the .pem/.key you downloaded).
# Must be a file PATH — do not paste key contents here.
# Example: ~/.ssh/my-server-key.pem
SSH_KEY_PATH=

# OPTIONAL — only change from default 22 if your server uses a non-standard SSH port
# SSH connection port on the server (not your app port).
SSH_SSH_PORT=22

# OPTIONAL — only required for GitHub Actions / CI — paste private key contents here; use SSH_KEY_PATH for local development
# PRIVATE SSH key contents (full PEM block including BEGIN/END lines).
SSH_KEY=

# OPTIONAL — only when this environment uses a DeployHub-managed .env (envFileSecretName in config)
# FULL CONTENTS of the project .env file (paste as a GitHub Secret).
# Uploaded to the server on every deploy (including rollback) via SFTP — never committed.
# Overwrites the remote .env each deploy. Do not also hand-place a .env for this environment.
ENV_FILE=

