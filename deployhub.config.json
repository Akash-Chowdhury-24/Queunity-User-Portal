{
  "project": "queunity-user-portal",
  "version": "2026.10.05.1315",
  "projectType": "backend",
  "artifact": true,
  "storage": [
    "aws"
  ],
  "defaultEnvironment": "default",
  "unprefixedSecretEnvironment": "default",
  "legacyHistoryMigrated": true,
  "environments": {
    "default": {
      "enabled": true,
      "method": "docker",
      "trigger": "push",
      "config": {
        "deploymentType": "server",
        "dockerImageName": "akashwpd/queunity-user-portal",
        "dockerRegistryUrl": "",
        "remote": {
          "mode": "ssh"
        },
        "dockerHost": "",
        "host": "43.204.32.46",
        "user": "ec2-user",
        "port": 8002,
        "hooks": {
          "preDeploy": [
            {
              "command": "sudo dnf update -y",
              "continueOnError": false
            },
            {
              "command": "sudo dnf install -y docker",
              "continueOnError": false,
              "reconnect": true
            },
            {
              "command": "sudo systemctl enable --now docker",
              "continueOnError": false
            },
            {
              "command": "sudo usermod -aG docker ec2-user",
              "continueOnError": false,
              "reconnect": true
            }
          ]
        },
        "envFileSecretName": "ENV_FILE"
      },
      "branch": "dev"
    }
  },
  "healthCheck": {
    "url": "",
    "timeout": 30
  },
  "notifications": {
    "slack": false,
    "email": false,
    "webhook": false
  },
  "pipeline": {
    "test": true,
    "docker": true,
    "deploy": true,
    "verify": false,
    "notify": false
  },
  "artifactRetention": 10,
  "cli": {
    "source": "npm:@akash-chowdhury-24/deployhub"
  },
  "framework": "fastapi",
  "language": "python",
  "buildCommand": null,
  "startCommand": "uvicorn main:app --host 0.0.0.0 --port 8002",
  "buildOutput": ".",
  "port": 8002,
  "docker": true
}
